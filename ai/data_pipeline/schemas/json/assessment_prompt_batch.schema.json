{
  "$defs": {
    "AssessmentPrompt": {
      "additionalProperties": false,
      "description": "System prompt chấm bài, lưu như dữ liệu để version được.",
      "properties": {
        "output_schema_ref": {
          "default": "AssessmentResult",
          "title": "Output Schema Ref",
          "type": "string"
        },
        "prompt_id": {
          "minLength": 1,
          "title": "Prompt Id",
          "type": "string"
        },
        "rubric_ref": {
          "minLength": 1,
          "title": "Rubric Ref",
          "type": "string"
        },
        "system_prompt": {
          "minLength": 100,
          "title": "System Prompt",
          "type": "string"
        },
        "target": {
          "pattern": "^(speaking|writing)$",
          "title": "Target",
          "type": "string"
        },
        "version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "prompt_id",
        "target",
        "rubric_ref",
        "system_prompt"
      ],
      "title": "AssessmentPrompt",
      "type": "object"
    },
    "BatchMetadata": {
      "additionalProperties": false,
      "description": "Header của mọi file batch — §2.2.",
      "properties": {
        "batch_id": {
          "minLength": 1,
          "title": "Batch Id",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "generated_by": {
          "minLength": 1,
          "title": "Generated By",
          "type": "string"
        },
        "is_ai_generated": {
          "default": true,
          "title": "Is Ai Generated",
          "type": "boolean"
        },
        "module_type": {
          "$ref": "#/$defs/ModuleType"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "draft"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "total_records": {
          "minimum": 0,
          "title": "Total Records",
          "type": "integer"
        }
      },
      "required": [
        "batch_id",
        "module_type",
        "generated_by",
        "generated_at",
        "total_records"
      ],
      "title": "BatchMetadata",
      "type": "object"
    },
    "ModuleType": {
      "description": "8 loại batch — §2.2.",
      "enum": [
        "FLASHCARD",
        "GRAMMAR",
        "COLLOCATION",
        "EXAM",
        "SPEAKING",
        "WRITING",
        "SHADOWING",
        "ASSESSMENT_PROMPT"
      ],
      "title": "ModuleType",
      "type": "string"
    },
    "ReviewStatus": {
      "enum": [
        "draft",
        "auto_validated",
        "human_approved"
      ],
      "title": "ReviewStatus",
      "type": "string"
    }
  },
  "$id": "https://englow3.local/schemas/assessment_prompt_batch.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "batch_metadata": {
      "$ref": "#/$defs/BatchMetadata"
    },
    "prompts": {
      "items": {
        "$ref": "#/$defs/AssessmentPrompt"
      },
      "title": "Prompts",
      "type": "array"
    }
  },
  "required": [
    "batch_metadata"
  ],
  "title": "AssessmentPromptBatch",
  "type": "object"
}
