SERVER_PORT=8080
# ---------------DB-----------------
DB_URL=jdbc:postgresql://localhost:5432/postgres?sslmode=require&currentSchema=englow3
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ---------------AUTH (Supabase JWT)-----------------
SUPABASE_JWKS_URI=https://localhost.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER_URI=https://localhost.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# ---------------CORS-----------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------S3 STORAGE-----------------
STORAGE_PUBLIC_BUCKET=images
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/images
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=englow3
