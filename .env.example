SERVER_PORT=8080
# ---------------DB-----------------
DB_URL=jdbc:postgresql://localhost:5432/postgres?sslmode=require&currentSchema=englow3
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ---------------AUTH (Supabase JWT)-----------------
SUPABASE_JWKS_URI=https://localhost.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER_URI=https://localhost.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# ---------------CORS-----------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------REDIS-----------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=Englow3@123

# ---------------S3 STORAGE-----------------
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/englow3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=englow3

# ---------------AI-----------------
AI_ENABLED=false
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_DEFAULT_MODEL=llama-3.3-70b-versatile
AI_DAILY_REQUEST_LIMIT=100

# ---------------SPEECH (Azure Pronunciation Assessment)-----------------
SPEECH_ENABLED=false
AZURE_SPEECH_BASE_URL=https://your-resource.cognitiveservices.azure.com
AZURE_SPEECH_API_KEY=
SPEECH_LOCALE=en-US
