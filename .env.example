SERVER_PORT=8080
# ---------------DB-----------------
DB_URL=jdbc:postgresql://localhost:5432/postgres?sslmode=require&currentSchema=englow3
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ---------------AUTH (Supabase JWT)-----------------
SUPABASE_JWKS_URI=https://localhost.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER_URI=https://localhost.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# ---------------CORS-----------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------S3 STORAGE-----------------
STORAGE_PUBLIC_BUCKET=images
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/images
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=englow3

# ---------------AI-----------------
AI_ENABLED=false
AI_PROVIDER=ai-service
AI_SERVICE_BASE_URL=http://localhost:8001
AI_SERVICE_INTERNAL_API_KEY=replace-with-a-long-random-secret
AI_DEFAULT_MODEL=llama-3.3-70b-versatile
AI_CONNECT_TIMEOUT=5s
AI_READ_TIMEOUT=45s
AI_MAX_OUTPUT_TOKENS=2048
AI_DAILY_REQUEST_LIMIT=100
AI_WORKER_FIXED_DELAY=2s
AI_WORKER_BATCH_SIZE=5
AI_WORKER_LOCK_TIMEOUT=5m
AI_WORKER_RECONCILE_DELAY=1m

# ---------------SPEECH (Spring feature settings)-----------------
SPEECH_ENABLED=false
SPEECH_LOCALE=en-US
SPEECH_MAX_AUDIO_BYTES=10485760
SPEECH_UPLOAD_URL_TTL=10m
SPEECH_AUDIO_RETENTION=30d

# ---------------FASTAPI AI SERVICE / PROVIDER SECRETS-----------------
AI_SERVICE_ENVIRONMENT=development
AI_SERVICE_LLM_ENABLED=false
AI_SERVICE_LLM_BASE_URL=https://api.groq.com/openai/v1
AI_SERVICE_LLM_API_KEY=
AI_SERVICE_SPEECH_ENABLED=false
AI_SERVICE_AZURE_SPEECH_BASE_URL=https://your-resource.cognitiveservices.azure.com
AI_SERVICE_AZURE_SPEECH_API_KEY=
AI_SERVICE_CONNECT_TIMEOUT_SECONDS=5
AI_SERVICE_READ_TIMEOUT_SECONDS=45
AI_SERVICE_MAX_AUDIO_BYTES=10485760
