{
  "$defs": {
    "ReviewStatus": {
      "enum": [
        "draft",
        "auto_validated",
        "human_approved"
      ],
      "title": "ReviewStatus",
      "type": "string"
    }
  },
  "$id": "https://englow3.local/schemas/speaking_task.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "11 task theo định dạng TOEIC S&W (§Phase 9).",
  "properties": {
    "concept_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Concept Ids",
      "type": "array"
    },
    "difficulty_prior": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Difficulty Prior",
      "type": "number"
    },
    "part_number": {
      "maximum": 11,
      "minimum": 1,
      "title": "Part Number",
      "type": "integer"
    },
    "prep_time_sec": {
      "maximum": 120,
      "minimum": 0,
      "title": "Prep Time Sec",
      "type": "integer"
    },
    "prompt": {
      "minLength": 10,
      "title": "Prompt",
      "type": "string"
    },
    "response_time_sec": {
      "maximum": 120,
      "minimum": 1,
      "title": "Response Time Sec",
      "type": "integer"
    },
    "review_status": {
      "$ref": "#/$defs/ReviewStatus",
      "default": "draft"
    },
    "rubric_ref": {
      "minLength": 1,
      "title": "Rubric Ref",
      "type": "string"
    },
    "sample_answer_c1": {
      "minLength": 30,
      "title": "Sample Answer C1",
      "type": "string"
    },
    "task_id": {
      "default": "",
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "prompt",
    "sample_answer_c1",
    "rubric_ref",
    "concept_ids",
    "difficulty_prior",
    "part_number",
    "prep_time_sec",
    "response_time_sec"
  ],
  "title": "SpeakingTask",
  "type": "object"
}
