{
  "$defs": {
    "Accent": {
      "description": "Lỗi P1-6 — bắt buộc trên mọi AudioAsset.",
      "enum": [
        "US",
        "UK",
        "AU",
        "CA"
      ],
      "title": "Accent",
      "type": "string"
    },
    "AlignmentStatus": {
      "enum": [
        "pending",
        "aligned",
        "failed"
      ],
      "title": "AlignmentStatus",
      "type": "string"
    },
    "AudioAsset": {
      "additionalProperties": false,
      "properties": {
        "accent": {
          "$ref": "#/$defs/Accent"
        },
        "alignment_status": {
          "$ref": "#/$defs/AlignmentStatus",
          "default": "pending"
        },
        "audio_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audio Url"
        },
        "cues": {
          "items": {
            "$ref": "#/$defs/AudioCue"
          },
          "title": "Cues",
          "type": "array"
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "script": {
          "minLength": 10,
          "title": "Script",
          "type": "string"
        },
        "speaker_count": {
          "default": 1,
          "maximum": 4,
          "minimum": 1,
          "title": "Speaker Count",
          "type": "integer"
        }
      },
      "required": [
        "script",
        "accent"
      ],
      "title": "AudioAsset",
      "type": "object"
    },
    "AudioCue": {
      "additionalProperties": false,
      "description": "A verified time range for one utterance in a generated audio asset.",
      "properties": {
        "end_ms": {
          "exclusiveMinimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "speaker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "start_ms",
        "end_ms"
      ],
      "title": "AudioCue",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "draft",
        "auto_validated",
        "human_approved"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "WritingTaskType": {
      "enum": [
        "email",
        "opinion_essay",
        "picture_description"
      ],
      "title": "WritingTaskType",
      "type": "string"
    }
  },
  "$id": "https://englow3.local/schemas/writing_task.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "8 task theo định dạng TOEIC S&W (§Phase 9).",
  "properties": {
    "audio": {
      "anyOf": [
        {
          "$ref": "#/$defs/AudioAsset"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "concept_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Concept Ids",
      "type": "array"
    },
    "difficulty_prior": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Difficulty Prior",
      "type": "number"
    },
    "high_scoring_vocab": {
      "items": {
        "type": "string"
      },
      "title": "High Scoring Vocab",
      "type": "array"
    },
    "image_url": {
      "anyOf": [
        {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image Url"
    },
    "max_words": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Words"
    },
    "min_words": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Min Words"
    },
    "prompt": {
      "minLength": 10,
      "title": "Prompt",
      "type": "string"
    },
    "review_status": {
      "$ref": "#/$defs/ReviewStatus",
      "default": "draft"
    },
    "rubric_ref": {
      "minLength": 1,
      "title": "Rubric Ref",
      "type": "string"
    },
    "sample_answer_c1": {
      "minLength": 30,
      "title": "Sample Answer C1",
      "type": "string"
    },
    "stimulus_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stimulus Text"
    },
    "task_id": {
      "default": "",
      "title": "Task Id",
      "type": "string"
    },
    "task_type": {
      "$ref": "#/$defs/WritingTaskType"
    }
  },
  "required": [
    "prompt",
    "sample_answer_c1",
    "rubric_ref",
    "concept_ids",
    "difficulty_prior",
    "task_type"
  ],
  "title": "WritingTask",
  "type": "object"
}
