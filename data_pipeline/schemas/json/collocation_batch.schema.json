{
  "$defs": {
    "BatchMetadata": {
      "additionalProperties": false,
      "description": "Header của mọi file batch — §2.2.",
      "properties": {
        "batch_id": {
          "minLength": 1,
          "title": "Batch Id",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "generated_by": {
          "minLength": 1,
          "title": "Generated By",
          "type": "string"
        },
        "is_ai_generated": {
          "default": true,
          "title": "Is Ai Generated",
          "type": "boolean"
        },
        "module_type": {
          "$ref": "#/$defs/ModuleType"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "draft"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "total_records": {
          "minimum": 0,
          "title": "Total Records",
          "type": "integer"
        }
      },
      "required": [
        "batch_id",
        "module_type",
        "generated_by",
        "generated_at",
        "total_records"
      ],
      "title": "BatchMetadata",
      "type": "object"
    },
    "CEFRLevel": {
      "description": "§3.2 — C2 nằm ngoài phạm vi.",
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C1"
      ],
      "title": "CEFRLevel",
      "type": "string"
    },
    "Collocation": {
      "additionalProperties": false,
      "description": "Lỗi P1-9: object có `pattern`, không phải mảng chuỗi phẳng.",
      "properties": {
        "cefr": {
          "$ref": "#/$defs/CEFRLevel"
        },
        "pattern": {
          "$ref": "#/$defs/CollocationPattern"
        },
        "text": {
          "minLength": 3,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "pattern",
        "text",
        "cefr"
      ],
      "title": "Collocation",
      "type": "object"
    },
    "CollocationPattern": {
      "description": "Lỗi P1-9: collocation là object có `pattern`, không phải chuỗi phẳng.",
      "enum": [
        "V+N",
        "ADJ+N",
        "N+N",
        "V+PREP",
        "PREP+N",
        "ADV+ADJ",
        "N+PREP"
      ],
      "title": "CollocationPattern",
      "type": "string"
    },
    "ModuleType": {
      "description": "8 loại batch — §2.2.",
      "enum": [
        "FLASHCARD",
        "GRAMMAR",
        "COLLOCATION",
        "EXAM",
        "SPEAKING",
        "WRITING",
        "SHADOWING",
        "ASSESSMENT_PROMPT"
      ],
      "title": "ModuleType",
      "type": "string"
    },
    "ReviewStatus": {
      "enum": [
        "draft",
        "auto_validated",
        "human_approved"
      ],
      "title": "ReviewStatus",
      "type": "string"
    }
  },
  "$id": "https://englow3.local/schemas/collocation_batch.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "batch_metadata": {
      "$ref": "#/$defs/BatchMetadata"
    },
    "collocations": {
      "items": {
        "$ref": "#/$defs/Collocation"
      },
      "title": "Collocations",
      "type": "array"
    }
  },
  "required": [
    "batch_metadata"
  ],
  "title": "CollocationBatch",
  "type": "object"
}
