{
  "$defs": {
    "Accent": {
      "description": "Lỗi P1-6 — bắt buộc trên mọi AudioAsset.",
      "enum": [
        "US",
        "UK",
        "AU",
        "CA"
      ],
      "title": "Accent",
      "type": "string"
    },
    "BatchMetadata": {
      "additionalProperties": false,
      "description": "Header của mọi file batch — §2.2.",
      "properties": {
        "batch_id": {
          "minLength": 1,
          "title": "Batch Id",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "generated_by": {
          "minLength": 1,
          "title": "Generated By",
          "type": "string"
        },
        "is_ai_generated": {
          "default": true,
          "title": "Is Ai Generated",
          "type": "boolean"
        },
        "module_type": {
          "$ref": "#/$defs/ModuleType"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "draft"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "total_records": {
          "minimum": 0,
          "title": "Total Records",
          "type": "integer"
        }
      },
      "required": [
        "batch_id",
        "module_type",
        "generated_by",
        "generated_at",
        "total_records"
      ],
      "title": "BatchMetadata",
      "type": "object"
    },
    "CEFRLevel": {
      "description": "§3.2 — C2 nằm ngoài phạm vi.",
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C1"
      ],
      "title": "CEFRLevel",
      "type": "string"
    },
    "ModuleType": {
      "description": "8 loại batch — §2.2.",
      "enum": [
        "FLASHCARD",
        "GRAMMAR",
        "COLLOCATION",
        "EXAM",
        "SPEAKING",
        "WRITING",
        "SHADOWING",
        "ASSESSMENT_PROMPT"
      ],
      "title": "ModuleType",
      "type": "string"
    },
    "ReviewStatus": {
      "enum": [
        "draft",
        "auto_validated",
        "human_approved"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "ShadowingClip": {
      "additionalProperties": false,
      "description": "§Phase 8C — 20–30 đoạn 30–60 giây, có timestamp từng câu.",
      "properties": {
        "accent": {
          "$ref": "#/$defs/Accent"
        },
        "audio_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audio Url"
        },
        "cefr_level": {
          "$ref": "#/$defs/CEFRLevel"
        },
        "clip_id": {
          "minLength": 1,
          "title": "Clip Id",
          "type": "string"
        },
        "concept_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Concept Ids",
          "type": "array"
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "script": {
          "minLength": 20,
          "title": "Script",
          "type": "string"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/ShadowingSegment"
          },
          "minItems": 1,
          "title": "Segments",
          "type": "array"
        }
      },
      "required": [
        "clip_id",
        "cefr_level",
        "accent",
        "script",
        "segments",
        "concept_ids"
      ],
      "title": "ShadowingClip",
      "type": "object"
    },
    "ShadowingSegment": {
      "additionalProperties": false,
      "properties": {
        "end_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Ms"
        },
        "order": {
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "start_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Ms"
        },
        "text": {
          "minLength": 3,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "order",
        "text"
      ],
      "title": "ShadowingSegment",
      "type": "object"
    }
  },
  "$id": "https://englow3.local/schemas/shadowing_batch.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "batch_metadata": {
      "$ref": "#/$defs/BatchMetadata"
    },
    "clips": {
      "items": {
        "$ref": "#/$defs/ShadowingClip"
      },
      "title": "Clips",
      "type": "array"
    }
  },
  "required": [
    "batch_metadata"
  ],
  "title": "ShadowingBatch",
  "type": "object"
}
