{
  "$defs": {
    "BandDescriptor": {
      "additionalProperties": false,
      "properties": {
        "band": {
          "maximum": 5,
          "minimum": 0,
          "title": "Band",
          "type": "integer"
        },
        "descriptor_en": {
          "minLength": 10,
          "title": "Descriptor En",
          "type": "string"
        },
        "descriptor_vi": {
          "minLength": 10,
          "title": "Descriptor Vi",
          "type": "string"
        }
      },
      "required": [
        "band",
        "descriptor_en",
        "descriptor_vi"
      ],
      "title": "BandDescriptor",
      "type": "object"
    },
    "BatchMetadata": {
      "additionalProperties": false,
      "description": "Header của mọi file batch — §2.2.",
      "properties": {
        "batch_id": {
          "minLength": 1,
          "title": "Batch Id",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "generated_by": {
          "minLength": 1,
          "title": "Generated By",
          "type": "string"
        },
        "is_ai_generated": {
          "default": true,
          "title": "Is Ai Generated",
          "type": "boolean"
        },
        "module_type": {
          "$ref": "#/$defs/ModuleType"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "draft"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "total_records": {
          "minimum": 0,
          "title": "Total Records",
          "type": "integer"
        }
      },
      "required": [
        "batch_id",
        "module_type",
        "generated_by",
        "generated_at",
        "total_records"
      ],
      "title": "BatchMetadata",
      "type": "object"
    },
    "ModuleType": {
      "description": "8 loại batch — §2.2.",
      "enum": [
        "FLASHCARD",
        "GRAMMAR",
        "COLLOCATION",
        "EXAM",
        "SPEAKING",
        "WRITING",
        "SHADOWING",
        "ASSESSMENT_PROMPT"
      ],
      "title": "ModuleType",
      "type": "string"
    },
    "ReviewStatus": {
      "enum": [
        "draft",
        "auto_validated",
        "human_approved"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "Rubric": {
      "additionalProperties": false,
      "description": "Tách riêng; task chỉ giữ `rubric_ref` (§2.6).",
      "properties": {
        "dimensions": {
          "items": {
            "$ref": "#/$defs/RubricDimension"
          },
          "minItems": 1,
          "title": "Dimensions",
          "type": "array"
        },
        "name": {
          "minLength": 3,
          "title": "Name",
          "type": "string"
        },
        "rubric_id": {
          "default": "",
          "title": "Rubric Id",
          "type": "string"
        },
        "version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "dimensions"
      ],
      "title": "Rubric",
      "type": "object"
    },
    "RubricDimension": {
      "additionalProperties": false,
      "properties": {
        "band_descriptors": {
          "items": {
            "$ref": "#/$defs/BandDescriptor"
          },
          "minItems": 6,
          "title": "Band Descriptors",
          "type": "array"
        },
        "concept_id": {
          "minLength": 2,
          "title": "Concept Id",
          "type": "string"
        },
        "name": {
          "minLength": 2,
          "title": "Name",
          "type": "string"
        },
        "weight": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "name",
        "weight",
        "concept_id",
        "band_descriptors"
      ],
      "title": "RubricDimension",
      "type": "object"
    },
    "WritingTask": {
      "additionalProperties": false,
      "description": "8 task theo định dạng TOEIC S&W (§Phase 9).",
      "properties": {
        "concept_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Concept Ids",
          "type": "array"
        },
        "difficulty_prior": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Difficulty Prior",
          "type": "number"
        },
        "high_scoring_vocab": {
          "items": {
            "type": "string"
          },
          "title": "High Scoring Vocab",
          "type": "array"
        },
        "max_words": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Words"
        },
        "min_words": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Words"
        },
        "prompt": {
          "minLength": 10,
          "title": "Prompt",
          "type": "string"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "draft"
        },
        "rubric_ref": {
          "minLength": 1,
          "title": "Rubric Ref",
          "type": "string"
        },
        "sample_answer_c1": {
          "minLength": 30,
          "title": "Sample Answer C1",
          "type": "string"
        },
        "task_id": {
          "default": "",
          "title": "Task Id",
          "type": "string"
        },
        "task_type": {
          "$ref": "#/$defs/WritingTaskType"
        }
      },
      "required": [
        "prompt",
        "sample_answer_c1",
        "rubric_ref",
        "concept_ids",
        "difficulty_prior",
        "task_type"
      ],
      "title": "WritingTask",
      "type": "object"
    },
    "WritingTaskType": {
      "enum": [
        "email",
        "opinion_essay",
        "picture_description"
      ],
      "title": "WritingTaskType",
      "type": "string"
    }
  },
  "$id": "https://englow3.local/schemas/writing_batch.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "batch_metadata": {
      "$ref": "#/$defs/BatchMetadata"
    },
    "rubrics": {
      "items": {
        "$ref": "#/$defs/Rubric"
      },
      "title": "Rubrics",
      "type": "array"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/WritingTask"
      },
      "title": "Tasks",
      "type": "array"
    }
  },
  "required": [
    "batch_metadata"
  ],
  "title": "WritingBatch",
  "type": "object"
}
